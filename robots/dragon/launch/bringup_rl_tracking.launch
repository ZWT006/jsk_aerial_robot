<?xml version="1.0"?>
<launch>
  ###########  launch config  ###########
  # roslaunch dragon bringup_rl_tracking.launch rm:=False sim:=True headless:=False
  # roslaunch dragon bringup_rl_tracking.launch rm:=True sim:=False headless:=True
  <arg name="rm" default="False" />
  <arg name="sim" default="True" />
  <arg name="real_machine" default="$(arg rm)" />
  <arg name="simulation" default="$(arg sim)" />

  <arg name="full_vectoring_mode" default="true" />
  <arg name="new_model" default="true" />
  <arg name="model_name" value="v1_5_202601" if="$(arg new_model)"/>
  <arg name="model_name" value="vim4_202311" unless="$(arg new_model)"/>
  <arg name="link_num" default="quad" />
  <arg name="battery" default="true" />
  <arg name="suffix" value="" if="$(arg battery)" />
  <arg name="suffix" value="_no_bat" unless="$(arg battery)" />
  <arg name="dji_on" default="false" />
  <arg name="robot_model_suffix" value="$(arg suffix)" unless="$(eval arg('new_model') and arg('dji_on'))" />
  <arg name="robot_model_suffix" value="_dji_on" if="$(eval arg('new_model') and arg('dji_on') and arg('battery'))" />
  <arg name="robot_model_suffix" value="_dji_on_no_bat" if="$(eval arg('new_model') and arg('dji_on') and not arg('battery'))" />
  <arg name="estimate_mode" default="1" />
  <arg name="sim_estimate_mode" default="2" />
  <arg name="takeoff_height" default="0" />

  <arg name="worldtype" default="$(find aerial_robot_simulation)/gazebo_model/world/empty.world" />
  <arg name="launch_gazebo" default="True" />
  <arg name="direct_model" default="False" />
  <arg name="direct_model_name" />
  <arg name="spawn_x" default="0.0"/>
  <arg name="spawn_y" default="0.0"/>
  <arg name="spawn_z" default="0.0"/>
  <arg name="spawn_yaw" default="0.0"/>
  <arg name="spawn_joint_args" default="-J joint1_yaw 1.57 -J joint2_yaw 1.57 -J joint3_yaw 1.57" />
  <arg name="mujoco" default="False" />
  <arg name="robot_id" default="" />
  <arg name="robot_ns" value="dragon$(arg robot_id)" />
  <arg name="config_dir" default="$(find dragon)/config/$(arg link_num)/$(arg model_name)" />
  <arg name="headless" default="True" />

  <arg name="policy" default="" />
  <arg name="target_state_topic" default="" />

  ###########  UAV Config  ###########
  <group ns="$(arg robot_ns)">

    ###########  Basic Param  ###########
    <param name="estimation/mode" value="$(arg sim_estimate_mode)" if="$(arg simulation)" />
    <param name="estimation/mode" value="$(arg estimate_mode)" if="$(arg real_machine)"/>
    <param name="uav_model" value="32" />
    <rosparam file="$(arg config_dir)/model/FullVectoringRobotModel.yaml" command="load" if="$(arg full_vectoring_mode)" />
    <rosparam file="$(arg config_dir)/model/HydrusLikeRobotModel.yaml" command="load" unless="$(arg full_vectoring_mode)" />

    ###########  Motor Config  ###########
    <rosparam file="$(arg config_dir)/MotorInfo.yaml" command="load" />

    ###########  Servo Config  ###########
    <group ns="servo_controller" clear_params="true">
    </group>
    <!-- <rosparam file="$(arg config_dir)/Servo.yaml" command="load" if="$(eval arg('simulation') and not arg('real_machine'))"/> -->
    <!-- <rosparam file="$(arg config_dir)/RLServo.yaml" command="load" if="$(eval arg('simulation') and not arg('real_machine'))"/> -->
    <rosparam file="$(arg config_dir)/RLServoAsyn.yaml" command="load" if="$(eval arg('simulation') and not arg('real_machine'))"/>
    <!-- <rosparam file="$(arg config_dir)/pidGimbalServo.yaml" command="load" if="$(eval arg('simulation') and not arg('real_machine'))"/> -->
    <rosparam file="$(arg config_dir)/Servo.yaml" command="load" if="$(eval arg('real_machine') and not arg('simulation'))"/>

    ###########  Battery Config  ###########
    <rosparam file="$(arg config_dir)/Battery.yaml" command="load" />

    ###########  Sensor Fusion  ###########
    <rosparam file="$(arg config_dir)/StateEstimation.yaml" command="load" />
    <rosparam file="$(arg config_dir)/Simulation.yaml" command="load" if="$(eval arg('simulation') and not arg('real_machine'))"/>

    ###########  RL Control  ###########
    <rosparam file="$(arg config_dir)/control/TrackerRLAgentConfigSim.yaml" command="load" if="$(eval arg('simulation') and not arg('real_machine'))"/>
    <rosparam file="$(arg config_dir)/control/TrackerRLAgentConfigReal.yaml" command="load" if="$(eval arg('real_machine') and not arg('simulation'))"/>
    <param name="rlagent/onnx_model_path" value="$(arg policy)" unless="$(eval arg('policy') == '')" />
    <param name="rlagent/target_state_topic" value="$(arg target_state_topic)" unless="$(eval arg('target_state_topic') == '')" />
    <param name="controller/rotor_interfere_compensate" value="false" if="$(eval not arg('real_machine') and arg('simulation'))" />

    ###########  Navigation ###########
    <param name="flight_navigation_plugin_name" value="aerial_robot_navigation/dragon_navigation" />
    <rosparam file="$(arg config_dir)/NavigationConfig.yaml" command="load" />
    <param name="navigation/enable_full_state_target_bridge" value="false" />
    <param name="navigation/takeoff_height" value="$(arg takeoff_height)" if="$(eval arg('takeoff_height') > 0)"/>
  </group>

  ###########  Base Platform  ###########
  <node pkg="aerial_robot_base" type="aerial_robot_base_node" name="aerial_robot_base_node" ns="$(arg robot_ns)" output="screen">
    <param name="tf_prefix" value="$(arg robot_ns)"/>
    <param name="param_verbose" value="false"/>
    <param name="main_rate" value="200"/>
  </node>

  ###########  Robot Model  ###########
  <arg name="description_mode" value="urdf" unless="$(arg simulation)" />
  <arg name="description_mode" value="gazebo" if="$(arg simulation)" />
  <include file="$(find aerial_robot_model)/launch/aerial_robot_model.launch" >
    <arg name="headless" value="$(arg headless)" />
    <arg name="robot_model" value="$(find dragon)/robots/$(arg link_num)/$(arg model_name)_rl$(arg robot_model_suffix).$(arg description_mode).xacro" unless="$(arg direct_model)"/>
    <!-- <arg name="robot_model" value="$(find dragon)/robots/$(arg link_num)/$(arg model_name)$(arg robot_model_suffix).$(arg description_mode).xacro" unless="$(arg direct_model)"/> -->
    <arg name="robot_model" value="$(arg direct_model_name)" if="$(arg direct_model)"/>
    <arg name="robot_ns" value="$(arg robot_ns)" />
    <arg name="rviz_config" value="$(find dragon)/config/RLrviz_config" />
    <arg name="rviz_init_pose" value="$(arg config_dir)/RvizInit.yaml" />
    <arg name="need_joint_state" value="false" if="$(eval arg('simulation') or arg('real_machine'))"/>
  </include >

  ###########  Sensors  ###########
  <include file="$(find dragon)/launch/includes/$(arg model_name)/sensors.launch.xml" >
    <arg name="real_machine" value="$(arg real_machine)" />
    <arg name="simulation" value="$(arg simulation)" />
    <arg name="robot_ns" value="$(arg robot_ns)" />
  </include >

  ###########  Servo Bridge  ###########
  <node pkg="aerial_robot_model" type="servo_bridge_node" name="servo_bridge" output="screen" ns="$(arg robot_ns)">
    <param name="use_mujoco" value="true" if="$(arg mujoco)"/>
  </node>

  ########## Simulation in Gazebo #########
  <arg name="gazebo_gui" value="false" if="$(arg headless)" />
  <arg name="gazebo_gui" value="true" unless="$(arg headless)" />

  <include file="$(find gazebo_ros)/launch/empty_world.launch" if="$(eval arg('simulation') and not arg('real_machine') and not arg('mujoco') and arg('launch_gazebo'))">
    <arg name="world_name" value="$(arg worldtype)"/>
    <arg name="debug" value="false" />
    <arg name="gui" value="$(arg gazebo_gui)" />
    <arg name="paused" value="false"/>
    <arg name="use_sim_time" value="true"/>
    <arg name="headless" value="false"/>
  </include>

  <rosparam file="$(find aerial_robot_simulation)/config/Gazebo.yaml" command="load" ns="$(arg robot_ns)" if="$(eval arg('simulation') and not arg('real_machine') and not arg('mujoco'))" />
  <param name="$(arg robot_ns)/joint_state_controller/publish_rate" value="200" if="$(eval arg('simulation') and not arg('real_machine') and not arg('mujoco'))" />

  <node name="$(anon urdf_spawner)" pkg="gazebo_ros" type="spawn_model" respawn="false" output="screen"
        if="$(eval arg('simulation') and not arg('real_machine') and not arg('mujoco'))"
        args="-urdf -model $(arg robot_ns) -x $(arg spawn_x) -y $(arg spawn_y) -z $(arg spawn_z) -Y $(arg spawn_yaw) $(arg spawn_joint_args) -param $(arg robot_ns)/robot_description"/>

  <node name="controller_spawner" pkg="controller_manager" type="spawner" respawn="false"
        output="screen" ns="$(arg robot_ns)" args="joint_state_controller attitude_controller"
        if="$(eval arg('simulation') and not arg('real_machine') and not arg('mujoco'))" />

  ########## Simulation in Mujoco #########
  <include file="$(find aerial_robot_simulation)/launch/mujoco.launch" if="$(eval arg('simulation') and not arg('real_machine') and arg('mujoco'))" >
    <arg name="robot_ns" value="$(arg robot_ns)" />
    <arg name="headless" value="$(arg headless)"/>
    <arg name="mujoco_model" value="$(find dragon)/mujoco/$(arg link_num)/$(arg model_name)$(arg suffix)/robot.xml"/>
  </include>

</launch>
