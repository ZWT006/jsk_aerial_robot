<?xml version="1.0"?>
<robot
    xmlns:xacro="http://www.ros.org/wiki/xacro" name="dragon" >

  <!-- robot urdf -->
  <xacro:include filename="$(find dragon)/urdf/v1_5/dragon_common.xacro" />
  <xacro:include filename="$(find dragon)/urdf/v1_5/dragon_link.urdf.xacro" />
  <xacro:include filename="$(find dragon)/urdf/v1_5/dji_on_dragon.xacro" />

  <xacro:dragon_module self="1" child="2" baselink="false" battery="false"/>
  <xacro:dragon_module self="2" child="3" baselink="true"  battery="false"/>
  <xacro:dragon_module self="3" child="4" baselink="false" battery="false"/>
  <xacro:dragon_module self="4" child="4" baselink="false" battery="false"/>

  <xacro:dji_on_dragon_module />

  <!-- Livox MID360 -->
  <joint name="link22livox_mid360" type="fixed">
    <parent link="link2"/>
    <child link="livox_mid360"/>
    <origin xyz="0.132 0.0 0.05592" rpy="0 0 0"/>
  </joint>
  <link name="livox_mid360">
    <inertial>
      <origin xyz="0.0068 0.0 -0.0066" rpy="0 0 0"/>
      <mass value="0.2988"/>
      <inertia
          ixx="0.00018" iyy="0.00068" izz="0.00061"
          ixy="0.0" ixz="-0.0001" iyz="0.0"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://dragon/urdf/v1_5/mesh/sensor/livox_mid360_v1_5.stl"/>
      </geometry>
      <material name="dragon_matte_silver"/>
    </visual>
    <!-- optical window -->
    <visual name="livox_dome_visual">
      <origin rpy="0 0 0" xyz="0 0 0.009"/>
      <geometry>
        <sphere radius="0.0266"/>
      </geometry>
      <material name="dragon_gloss_blue"/>
    </visual>
  </link>

  <xacro:extra_module name = "lidar_imu" parent = "livox_mid360" visible = "0" >
    <origin xyz="0.011 0.02329 ${-0.02592 + 0.047 -0.04412}" rpy="0 0 0"/>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0"/>
      <inertia
          ixx="0.0" iyy="0.0" izz="0.0"
          ixy="0.0" ixz="0.0" iyz="0.0"/>
    </inertial>
  </xacro:extra_module>


</robot>
