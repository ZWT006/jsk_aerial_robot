<?xml version="1.0"?>
<launch>
    ###########  Deploy Controller  ###########
    # # # # Usage: The script will subscribe to sensor topics, run inference, and publish actions
    # 1. Launch ROS core and necessary nodes to publish sensor data (IMU, etc.)
    #    roslaunch gimbalrotor bringup.launch rm:=False sim:=True headless:=False
    # 2. Run this script 
    #    roslaunch gimbalrotor response.launch 
    # 3. the response will be logged to gimbal_response_log.csv in the /data folder of the package
    #    
    #############################################
  <node pkg="beetle_omni" type="gimbal_response" name="gimbal_response" output="screen" >
    
    <param name="save_path" value="$(find beetle_omni)/data"/>
    <param name="enable_save" value="False"/>
    <param name="control_freq" value="200"/>
    <param name="duration" value="200"/>
    <param name="default_gimbal" value="0.0"/>
    <param name="gimbal_range" value="3.5"/>
    <param name="cmd_period" value="0.04"/> <!-- perioded sweep signal -->
    
    <param name="effort_ctrl" value="False"/>
    <!-- <param name="kp" value="0.285"/>
    <param name="kd" value="0.019"/> -->
    <!-- <param name="kp" value="0.344964875"/>
    <param name="kd" value="0.0094725"/> -->
    <param name="kp" value="0.45"/>
    <param name="kd" value="0.008"/>
    
    <param name="sweep_mode" value="True"/>
    <param name="period_scale" value="50"/> <!-- 4.0 => 4x => 4.0s period -->

    <!-- step_mode: staircase step-response scan. Holds each level for cmd_period seconds,
         then advances by step_height rad; sweeps the full [-gimbal_range, +gimbal_range]
         workspace and reverses direction at the boundary. Disable sweep_mode to use this. -->
    <param name="step_mode" value="False"/>
    <param name="step_height" value="0.15"/> <!-- rad, increment applied every cmd_period -->

    <param name="constrained_chirp_mode" value="False"/>
    <param name="chirp_sweep_type" value="Linear"/>
    <param name="f_min" value="0.1"/>        <!-- 0.1 Hz -->
    <param name="f_max" value="5.0"/>        <!-- 5 Hz -->
    <param name="v_max" value="10.0"/>
    <param name="a_max" value="100.0"/>

    <param name="enable_gimbal_0" value="true"/>
    <param name="enable_gimbal_1" value="true"/>
    <param name="enable_gimbal_2" value="true"/>
    <param name="enable_gimbal_3" value="true"/>
    <remap from="~joint_states" to="/beetle_omni/joint_states"/>
  </node>
</launch>
